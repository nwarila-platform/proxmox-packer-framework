# ============================================================================================= #
# terraform.tfvars.example - Reference ISO pins for runner repositories                         #
#                                                                                               #
# This Packer framework does not consume this file directly. A runner repository can define an  #
# iso_pins variable like this, call terraform-proxmox-iso-manager-framework once per entry,      #
# and render the resulting module outputs into this framework's required boot_iso pkrvars       #
# object plus optional additional_iso_files.                                                     #
# ============================================================================================= #

iso_pins = {
  rocky_linux_9 = {
    family              = "rocky9"
    node                = "tcnhq-prxmx01"
    storage             = "cephFS"
    upload_timeout      = 600
    overwrite           = false
    overwrite_unmanaged = false

    iso_pin = {
      url      = "https://download.rockylinux.org/pub/rocky/9/isos/x86_64/Rocky-9.6-x86_64-dvd.iso"
      sha256   = "8ff2a47e2f3bfe442617fceb7ef289b7b1d2d0502089dbbd505d5368b2b3a90f"
      filename = "Rocky-9.6-x86_64-dvd.iso"
    }

    packer_device = {
      role              = "boot"
      cd_label          = null
      index             = 0
      keep_cdrom_device = false
      type              = "scsi"
      unmount           = true
    }
  }

  ubuntu_24_04_lts = {
    family              = "ubuntu24"
    node                = "tcnhq-prxmx01"
    storage             = "cephFS"
    upload_timeout      = 600
    overwrite           = false
    overwrite_unmanaged = false

    iso_pin = {
      url      = "https://releases.ubuntu.com/24.04.2/ubuntu-24.04.2-live-server-amd64.iso"
      sha256   = "d6fea1f11b4d23b481a48f34985f150d7d20ee0a7246b30f2e3bbfe6541ea4f0"
      filename = "ubuntu-24.04.2-live-server-amd64.iso"
    }

    packer_device = {
      role              = "boot"
      cd_label          = null
      index             = 0
      keep_cdrom_device = false
      type              = "scsi"
      unmount           = true
    }
  }

  windows_server_2022 = {
    family              = "windows-server-2022"
    node                = "tcnhq-prxmx01"
    storage             = "cephFS"
    upload_timeout      = 600
    overwrite           = false
    overwrite_unmanaged = false

    iso_pin = {
      url      = "https://software-static.download.prss.microsoft.com/sg/download/888969d5-f34g-4e03-ac9d-1f9786c66749/SERVER_EVAL_x64FRE_en-us.iso"
      sha256   = "3e4fa6d8507b554856fc9ca6079cc402df11a8b79344871669f0251535255325"
      filename = "SERVER_EVAL_x64FRE_en-us.iso"
    }

    packer_device = {
      role              = "boot"
      cd_label          = null
      index             = 0
      keep_cdrom_device = false
      type              = "sata"
      unmount           = true
    }
  }

  virtio_win = {
    family              = "virtio-win"
    node                = "tcnhq-prxmx01"
    storage             = "cephFS"
    upload_timeout      = 600
    overwrite           = false
    overwrite_unmanaged = false

    iso_pin = {
      url      = "https://fedorapeople.org/groups/virt/virtio-win/direct-downloads/archive-virtio/virtio-win-0.1.262-2/virtio-win-0.1.262.iso"
      sha256   = "ebd48258668f7f78e026ed276c28a9d19d83e020a36b24730bfba1a93eed3a35"
      filename = "virtio-win-0.1.262.iso"
    }

    packer_device = {
      role              = "additional"
      cd_label          = null
      index             = 2
      keep_cdrom_device = false
      type              = "sata"
      unmount           = true
    }
  }
}
