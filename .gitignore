# Ignore everything by default
**

# --- Root ---
!.gitignore
!.gitattributes
!.editorconfig
!.pre-commit.config.yaml
!.release-please-manifest.json
!release-please-config.json
!CHANGELOG.md
!CODE_OF_CONDUCT.md
!CONTRIBUTING.md
!LICENSE
!README.md
!SECURITY.md
!SUPPORT.md

# --- .config ---
!.config/
!.config/.markdownlint.json
!.config/.yamllint.yaml

# --- .github ---
!.github/
!.github/.gitkeep
!.github/CODEOWNERS
